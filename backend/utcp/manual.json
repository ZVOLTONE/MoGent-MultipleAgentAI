{
  "utcp_version": "1.0",
  "provider": "sectors_idx_v2",
  "base_url": "https://api.sectors.app/v2",
  "auth": { "type": "header", "name": "Authorization", "source": "env:SECTORS_API_KEY" },
  "notes": "API key never appears in prompts, logs, or responses (PRD 12.4).",
  "tools": [
    { "name": "get_company_report", "available": true,
      "input": { "symbol": "string", "sections": "optional string (overview,valuation,dividend,ownership,financials,peers,future,management)" } },
    { "name": "get_company_quarterly", "available": true, "source": "yfinance",
      "note": "Sectors API 404 pada tier ini; data kuartalan dari Yahoo Finance (.JK).",
      "input": { "symbol": "string" } },
    { "name": "get_daily_price", "available": true,
      "input": { "symbol": "string", "start": "optional YYYY-MM-DD", "end": "optional YYYY-MM-DD (max 90d)" } },
    { "name": "get_company_corporate_actions", "available": true,
      "input": { "symbol": "string" } },
    { "name": "search_idx_news", "available": true,
      "input": { "symbols": "optional string", "keyword": "optional string", "start": "optional", "end": "optional", "limit": "optional int<=30", "tags": "optional string" } },
    { "name": "get_filings", "available": true,
      "input": { "symbol": "optional string", "transaction_type": "optional buy|sell|others", "holder_type": "optional", "start": "optional", "end": "optional", "limit": "optional int<=30" } },
    { "name": "get_foreign_flow", "available": true,
      "input": { "symbol": "string", "start": "optional", "end": "optional" } },
    { "name": "get_shareholders", "available": true, "source": "yfinance",
      "note": "Sectors API 404 pada tier ini; komposisi kepemilikan dari Yahoo Finance (.JK).",
      "input": { "symbol": "string" } },
    { "name": "get_idx_total", "available": true,
      "input": { "start": "optional", "end": "optional (max 90d)" } },
    { "name": "get_index_daily", "available": true,
      "input": { "index": "string (lowercase e.g. idx30, lq45)", "start": "optional", "end": "optional" } },
    { "name": "screen_companies", "available": true,
      "input": { "where": "optional string", "order_by": "optional string", "q": "optional natural language" } },
    { "name": "get_macro_indicators", "available": true, "scraper": true,
      "source": "World Bank Open Data + exchangerate-api (keyless)",
      "input": {},
      "output": "inflasi tahunan %, suku bunga riil %, kurs USD/IDR; BI Rate dilaporkan tidak tersedia" },
    { "name": "search_macro_news_id", "available": true, "scraper": true,
      "source": "Antara / Google News RSS (id)",
      "input": { "keyword": "optional string", "limit": "optional int<=20" } },
    { "name": "search_macro_news_global", "available": true, "scraper": true,
      "source": "Google News RSS (global)",
      "input": { "keyword": "optional string", "limit": "optional int<=20" } },
    { "name": "search_web_news", "available": true, "scraper": true,
      "source": "CNN Indonesia + Google News (query bebas)",
      "input": { "query": "string", "scope": "optional id|global|all", "limit": "optional int<=20" } },
    { "name": "get_time", "available": true, "scraper": false,
      "source": "jam lokal server (WIB)",
      "input": {}, "output": "tanggal & waktu WIB untuk konteks kebaruan data" }
  ]
}
